# Public Worker URL only; never place a token or secret in a VITE_* variable.
VITE_API_BASE_URL=https://api.example.workers.dev

# Optional public tuning. Defaults shown below normally need no Vercel override.
VITE_ACTIVE_POLL_MS=30000
VITE_IDLE_POLL_MS=300000
VITE_OPERATION_POLL_MS=2000
VITE_OPERATION_TIMEOUT_MS=900000
