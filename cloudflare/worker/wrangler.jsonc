{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-weather-forecast-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "SNAPSHOTS",
      "id": "configure-in-cloudflare-dashboard"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173"
  }
}
