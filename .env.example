APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
SOURCE_BASE_URL=https://xsmn.mobi
SOURCE_TIMEOUT_SECONDS=8
SOURCE_CONNECT_TIMEOUT_SECONDS=3
SOURCE_MAX_RETRIES=3
SOURCE_MAX_CONCURRENCY=10
HISTORY_CACHE_TTL_SECONDS=300
REALTIME_ENABLED=true
REALTIME_TIMEZONE=Asia/Ho_Chi_Minh
REALTIME_ACTIVE_START=17:45
REALTIME_ACTIVE_END=19:00
REALTIME_ACTIVE_POLL_SECONDS=1.0
REALTIME_IDLE_POLL_SECONDS=30.0
REALTIME_HEARTBEAT_SECONDS=15
REALTIME_MIN_POLL_SECONDS=1.0
MANUAL_REFRESH_COOLDOWN_SECONDS=5

# Cloud jobs (required only by scripts/cloud_job.py and GitHub Actions)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=
CLOUD_MAX_VALUE_BYTES=20971520
CLOUD_OPERATION_TTL_SECONDS=86400
CLOUD_JOB_TIMEOUT_SECONDS=900

# Server-side notifications (Telegram / Zalo OA / Facebook)
NOTIFICATIONS_ENABLED=false
NOTIFICATION_DRY_RUN=false
NOTIFICATION_MIN_DAYS=19
NOTIFICATION_MAX_DAYS=25
NOTIFICATION_SEND_TIME=09:00
NOTIFICATION_CHECK_INTERVAL_SECONDS=60
NOTIFICATION_RETRY_INTERVAL_SECONDS=300
NOTIFICATION_REQUEST_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_RETRIES=2
NOTIFICATION_STATE_PATH=.data/notification-state.json
# Protects POST /api/notifications/test and /send-now. Generate a long random value.
NOTIFICATION_ADMIN_TOKEN=

TELEGRAM_BOT_TOKEN=
# Comma-separated chat, group, or channel IDs.
TELEGRAM_CHAT_IDS=

ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_APP_ID=
ZALO_APP_SECRET=
# Comma-separated Zalo OA user IDs.
ZALO_RECIPIENT_IDS=

FACEBOOK_GRAPH_API_VERSION=v26.0
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Comma-separated Page-scoped user IDs for Messenger.
FACEBOOK_MESSENGER_RECIPIENT_IDS=
# Optional: publish the same alert to the Page feed.
FACEBOOK_PUBLISH_TO_PAGE=false
